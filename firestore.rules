rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'uproll.fire.gai@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: Product
    function isValidProduct(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.price is number && data.price >= 0 && data.price <= 500000
        && data.category is string && data.category.size() <= 100
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 400))
        && (!('description' in data) || (data.description is string && data.description.size() <= 3000))
        && (!('compareAtPrice' in data) || (data.compareAtPrice is number && data.compareAtPrice >= 0))
        && (!('stock' in data) || (data.stock is number && data.stock >= 0))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('images' in data) || (data.images is list && data.images.size() <= 15 && data.images.size() > 0 && data.images[0] is string))
        && (!('featured' in data) || data.featured is bool)
        && (!('isTopProductHero' in data) || data.isTopProductHero is bool)
        && (!('heroOrder' in data) || (data.heroOrder is number && data.heroOrder >= 0))
        && (!('heroTagline' in data) || (data.heroTagline is string && data.heroTagline.size() <= 200))
        && (!('heroBadge' in data) || (data.heroBadge is string && data.heroBadge.size() <= 100));
    }

    // Validation Blueprint: HeroSlide
    function isValidHeroSlide(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && data.order is number && data.order >= 0
        && data.isActive is bool
        && (!('badge' in data) || (data.badge is string && data.badge.size() <= 100))
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 300))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('ctaText' in data) || (data.ctaText is string && data.ctaText.size() <= 100))
        && (!('price' in data) || (data.price is number && data.price >= 0))
        && (!('compareAtPrice' in data) || (data.compareAtPrice is number && data.compareAtPrice >= 0));
    }

    // Validation Blueprint: Order
    function isValidOrder(data) {
      return data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 100
        && data.total is number && data.total > 0 && data.total <= 1000000
        && data.status is string && data.status.size() <= 50
        && data.customer is map
        && data.customer.name is string && data.customer.name.size() > 0 && data.customer.name.size() <= 100
        && data.customer.phone is string && data.customer.phone.size() >= 10 && data.customer.phone.size() <= 20
        && data.customer.address is string && data.customer.address.size() > 0 && data.customer.address.size() <= 500
        && data.customer.pinCode is string && data.customer.pinCode.size() == 6
        && data.customer.city is string && data.customer.city.size() <= 100
        && data.customer.state is string && data.customer.state.size() <= 100
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Validation Blueprint: User
    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (!('role' in data) || (data.role in ['customer', 'admin']))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150));
    }

    // Connection Health Check Rule (Required for client connection verification)
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Products Collection
    // Public catalog read so all visitors can browse the store
    // Mutations strictly protected by admin role
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Hero Slides Collection
    // Public read so top product slider displays smoothly to all shoppers
    // Mutations controlled strictly from the Admin Dashboard
    match /hero_slides/{slideId} {
      allow get, list: if true;
      allow create: if isValidId(slideId) && isAdmin() && isValidHeroSlide(incoming());
      allow update: if isValidId(slideId) && isAdmin() && isValidHeroSlide(incoming());
      allow delete: if isValidId(slideId) && isAdmin();
    }

    // Orders Collection
    // PII Protection: Customers place orders freely, but only authorized admins or the ordering user can view them
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes']) &&
          incoming().status in ['cancelled']
        )
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().role != 'admin';
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          request.auth.uid == userId &&
          isValidUser(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone'])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins Collection - Master RBAC Gate
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
